# ==============================================================================
# PARVAT NETRA - Environment Configuration Template
# All secrets and API keys must be specified via local .env (never commit .env)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Database & Spatial Store (PostgreSQL / PostGIS / Neon)
# ------------------------------------------------------------------------------
# Format: postgresql://<username>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# External Application APIs (Consumed by FastAPI Backend)
# ------------------------------------------------------------------------------
# Weather Data Providers (IMD / Open-Meteo / PostGIS)
OPENWEATHER_API_KEY=
IMD_API_ENDPOINT=https://mausam.imd.gov.in/api
IMD_API_BASE_URL=
IMD_API_TOKEN=
WEATHER_PROVIDER=auto
WEATHER_CACHE_TTL=900

# Seismological Data Providers (NCS / USGS / Himalayan Fault Models)
NCS_API_BASE_URL=
NCS_API_TOKEN=
SEISMIC_PROVIDER=auto
SEISMIC_CACHE_TTL=300

# PAHAD Demonstration Mode (0 = Production Live Priority, 1 = Scenario Walkthrough)
PAHAD_DEMO_MODE=0

# Staging & Production Safety Controls (MANDATORY - CP05 & CP19)
ENABLE_PUBLIC_DISPATCH=0
SIREN_DRY_RUN=1
CAP_PRODUCTION_DISPATCH=0
SACHET_PRODUCTION_DISPATCH=0
CELL_BROADCAST_PRODUCTION=0
PUBLIC_DEMO_TEST_ONLY=1

# GIS & Routing APIs (Google Maps Platform / Mapbox / OpenStreetMap)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ROUTES_API_FALLBACK_MODE=local_geometric_graph

# Satellite / Earth Observation (Copernicus Data Space / Sentinel Hub)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# IoT Sensor Gateway (MQTT / Webhooks)
IOT_GATEWAY_URL=http://localhost:1883
IOT_GATEWAY_TOKEN=

# Notification Delivery Services
SLACK_WEBHOOK_URL=
EMERGENCY_SMS_GATEWAY_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMERGENCY_ALERT_SENDER=alerts@parvatnetra.gov.in

# ------------------------------------------------------------------------------
# Agent / Developer MCP Integration Tokens (Used by IDE / Antigravity Agent)
# ------------------------------------------------------------------------------
# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=

# Figma Integration
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_DESKTOP_ENDPOINT=http://127.0.0.1:3845/mcp
FIGMA_REMOTE_ENDPOINT=https://mcp.figma.com/mcp

# Neon MCP Integration
NEON_API_KEY=

# Google Cloud Run Deployment
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# ------------------------------------------------------------------------------
# Experiential Labs LLM Gateway (for gpt-6-astra)
# ------------------------------------------------------------------------------
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# ------------------------------------------------------------------------------
# PAHAD Phase 3.5: Intelligent Alerting & 15 km Geofence
# ------------------------------------------------------------------------------
PAHAD_ALERT_RADIUS_KM=15
PAHAD_ALERT_DEDUP_MINUTES=30
PAHAD_PUSH_DRY_RUN=true
PAHAD_SMS_DRY_RUN=true
PAHAD_SMS_PROVIDER=mock
PAHAD_VAPID_PUBLIC_KEY=
PAHAD_VAPID_PRIVATE_KEY=
PAHAD_VAPID_EMAIL=admin@parvatnetra.gov.in
PAHAD_SMS_GATEWAY_URL=
PAHAD_SMS_API_KEY=
