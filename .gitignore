# ==========================================
# PARVAT NETRA - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Credentials, tokens, keys & service accounts
*.pem
*.key
*.cert
*.crt
*credential*
*secret*
*token*
*service-account*.json
*-sa.json
service_account.json
credentials.json
auth_tokens.json
.auth/
.secrets/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js & Frontend build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
dist/
.turbo/

# IDE and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Databases & local stores
*.sqlite3
*.db
*.rdb

# Observability, Logs & Temp
*.log
*.bak
logs/
temp/
tmp/
scratch/
coverage/
.nyc_output/
~$*
static/uploads/
data/cache/


# Mobile / Android build artifacts
.gradle/
**/.gradle/
**/android/.gradle/
local.properties
**/android/local.properties

.vercel

# ==========================================
# PAHAD LSTM PRIVATE TRAINING ARTIFACTS
# CRITICAL: These files contain trained model weights and must NEVER be
# committed to any public repository. They remain local-only until the
# user explicitly approves making the trained model public.
# ==========================================
models/pahad_lstm_private_weights.pkl
models/pahad_lstm_private_metrics.json
models/pahad_lstm_private_weights_*.pkl
models/pahad_lstm_private_metrics_*.json
models/_lstm_private*/
scripts/_audit_db.py
scripts/_show_metrics.py
scripts/_deep_audit.py

# Real PyTorch LSTM v1 — PRIVATE DO NOT PUBLISH
models/pahad_lstm_real_weights.pt
models/pahad_lstm_real_config.json
models/pahad_lstm_real_metrics.json
models/pahad_lstm_real_weights_*.pt

# BiLSTM v2 (26-feature enhanced) — PRIVATE DO NOT PUBLISH
models/pahad_lstm_v2_weights.pt
models/pahad_lstm_v2_config.json
models/pahad_lstm_v2_metrics.json
models/pahad_lstm_v2_weights_*.pt
scripts/train_lstm_v2.py
