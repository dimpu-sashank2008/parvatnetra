# ==========================================
# PARVAT NETRA - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Credentials, tokens, keys & service accounts
*.pem
*.key
*.cert
*.crt
*credential*
*secret*
*token*
*service-account*.json
*-sa.json
service_account.json
credentials.json
auth_tokens.json
.auth/
.secrets/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js & Frontend build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
dist/
.turbo/

# IDE and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Databases & local stores
*.sqlite3
*.db
*.rdb

# Observability, Logs & Temp
*.log
*.bak
logs/
temp/
tmp/
scratch/
coverage/
.nyc_output/
~$*
static/uploads/
data/cache/


# Mobile / Android build artifacts
.gradle/
**/.gradle/
**/android/.gradle/
local.properties
**/android/local.properties

.vercel
