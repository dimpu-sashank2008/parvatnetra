                        <i class="ph-bold ph-crosshair"></i> <span>Center on GIS Map</span>
                    </button>
                    <button onclick="closeEvidenceModal()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-white rounded text-xs font-bold transition">
