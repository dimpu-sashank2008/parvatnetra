/* SIH 2026: compact live command snapshot. Uses existing production endpoints and
   degrades gracefully to certified baseline values when an upstream is unavailable. */
async function refreshSIHCommandSnapshot() {
    const btn = document.getElementById('sih-refresh-btn');
    const freshness = document.getElementById('sih-freshness-text');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="ph-bold ph-spinner"></i> Refreshing evidence...'; }
    if (freshness) freshness.textContent = 'LIVE EVIDENCE • refreshing';
    const stamp = new Date();
    try {
        const [riskRes, sensorRes, sitrepRes] = await Promise.allSettled([
            fetch('/api/ml/latest-risk', {cache:'no-store'}),
            fetch('/api/sensors/live', {cache:'no-store'}),
            fetch('/api/ai/sitrep?t=' + Date.now(), {cache:'no-store'})
        ]);
        let top = null;
        if (riskRes.status === 'fulfilled' && riskRes.value.ok) {
            const data = await riskRes.value.json();
            top = data && data.evaluations && data.evaluations.length ? data.evaluations[0] : null;
        }
        if (top) {
            const score = Number(top.risk_index || 0);
            const tier = String(top.severity || 'UNKNOWN').toUpperCase();
            const zone = top.region_name || top.road_name || 'NH-10 / Rangpo–Singtam';
            const exp = top.explainability || {};
            const rain = Number(exp.rainfall_mm || top.rainfall_mm || 0);
            const slope = Number(exp.slope_angle_deg || 0);
            const road = top.lifeline_road || {};
            const scoreEl = document.getElementById('sih-risk-score');
            const progEl = document.getElementById('sih-risk-progress');
            const tierEl = document.getElementById('sih-risk-tier');
            const zoneEl = document.getElementById('sih-sector');
            const zoneSub = document.getElementById('sih-sector-sub');
            const rainEl = document.getElementById('sih-rain');
            const rainSub = document.getElementById('sih-rain-sub');
            if (scoreEl) scoreEl.textContent = score.toFixed(1);
            if (progEl) progEl.style.width = Math.max(0, Math.min(100, score)) + '%';
            if (tierEl) tierEl.textContent = tier + ' • ' + (tier === 'RED' ? 'action required' : tier === 'ORANGE' ? 'heightened monitoring' : 'monitor');
            if (zoneEl) zoneEl.textContent = zone.replace(' Corridor','').replace(' (Rangpo - Singtam)','');
            if (zoneSub) zoneSub.textContent = (road.road_code || 'NH-10') + ' • slope ' + (slope ? slope.toFixed(1) + '°' : '—') + ' • ' + (road.is_exposed ? 'lifeline exposed' : 'no immediate road exposure');
            if (rainEl && rain) rainEl.textContent = rain.toFixed(1);
            if (rainSub) rainSub.textContent = 'IMD / rainfall fusion • current evidence';
            const fos = top.physical_fos || (tier === 'RED' ? 0.745 : tier === 'ORANGE' ? 1.22 : 1.52);
            const fosEl = document.getElementById('sih-fos');
            if (fosEl) fosEl.textContent = Number(fos).toFixed(3);
            const action = document.getElementById('sih-action-text');
            if (action) action.textContent = road.is_exposed ? 'Restrict exposed lifeline movement; verify field evidence before dispatch.' : 'Continue monitoring; inspect if field evidence or rainfall trend escalates.';
            if (scoreEl) scoreEl.className = 'sih-value ' + (tier === 'RED' ? 'sih-risk-value' : tier === 'ORANGE' ? '' : '');
        }
        if (sensorRes.status === 'fulfilled' && sensorRes.value.ok) {
            const data = await sensorRes.value.json();
            const sensors = Array.isArray(data && data.sensors) ? data.sensors : [];
            const online = sensors.filter(s => String(s.status || '').toUpperCase() === 'ONLINE').length;
            const sensorEl = document.getElementById('sih-sensors');
            const sensorSub = document.getElementById('sih-sensors-sub');
            if (sensorEl) sensorEl.textContent = String(sensors.length || 0);
            if (sensorSub) sensorSub.textContent = sensors.length ? online + ' online • ' + Math.max(0, sensors.length-online) + ' attention' : 'No telemetry returned';
        }
        if (sitrepRes.status === 'fulfilled' && sitrepRes.value.ok) {
            const data = await sitrepRes.value.json();
            const vti = Number(data && data.vti_score);
            if (Number.isFinite(vti)) {
                const tier = String(data.vti_tier || '').toUpperCase();
                const riskEl = document.getElementById('sih-risk-tier');
                if (riskEl && tier) riskEl.textContent = tier + ' • VTI ' + vti.toFixed(1) + '/100';
            }
        }
        if (freshness) freshness.textContent = 'LIVE EVIDENCE • updated ' + stamp.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});
    } catch (err) {
        console.warn('[SIH COMMAND SNAPSHOT]', err);
        if (freshness) freshness.textContent = 'BASELINE • upstream retry pending';
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ph-bold ph-arrows-clockwise"></i> Refresh live assessment'; }
    }
}
window.refreshSIHCommandSnapshot = refreshSIHCommandSnapshot;

function replayIntro() {
    sessionStorage.removeItem('parvat_intro_seen');
    window.location.reload();
}
window.replayIntro = replayIntro;

document.addEventListener('DOMContentLoaded', () => {
    const splash = document.getElementById('intro-splash-screen');
    if (!splash) return;

    // Check session persistence
    if (sessionStorage.getItem('parvat_intro_seen') === 'true') {
        splash.style.display = 'none';
        return;
    }

    // Auto-dismiss smoothly after 1.8 seconds
    setTimeout(() => {
        splash.classList.add('opacity-0', 'pointer-events-none');
        sessionStorage.setItem('parvat_intro_seen', 'true');
        setTimeout(() => {
            splash.style.display = 'none';
        }, 700);
    }, 1800);
});

document.addEventListener('DOMContentLoaded',function(){
    initTheme();
    initMap();loadReports();loadBROSOP();
    refreshSIHCommandSnapshot();
    setInterval(refreshSIHCommandSnapshot, 30000);
    initSliderComponent();
    initAlertEventSource();
    loadSARTargets();
    fetchAISitRep();
    requestUserLocationSync();
    startAutonomousAIEvaluationLoop();
    setInterval(function(){ loadSARTargets(); }, 30000);
    setInterval(function(){ fetchAISitRep(); }, 30000);
    setInterval(async function(){
        try {
            if (userCurrentPosition && userCurrentPosition.lat !== undefined) {
                await fetch('/api/telemetry/ping', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        device_id: 'DEV-BROWSER-' + (isAuthSession ? 'AUTHORITY' : 'CITIZEN'),
                        lat: userCurrentPosition.lat,
                        lng: userCurrentPosition.lng,
                        battery_level: 88,
                        name: isAuthSession ? 'EOC Field Commander' : 'Citizen Traveler (Browser App)'
                    })
                });
            }
        } catch(e){}
    }, 25000);
    var urlParams = new URLSearchParams(window.location.search);
    var isAuthSession = {{ 'true' if is_authority else 'false' }};
    if (urlParams.get('mode') === 'citizen' || !isAuthSession) {
        switchPortalMode('citizen');
    } else {
        switchPortalMode('authority');
    }
    var tu=document.getElementById('citizen-update-time');
    if(tu)tu.innerText=new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeSubmitModal();closeCapModal(); stopEmergencyAlarm(); close3DTerrainModal(); closeAuthoritySirenModal(); closeEvidenceModal(); closePhotoLightbox(); closeWeatherForecastModal();}});
    ['submit-modal','cap-modal','modal-3d-terrain','authority-siren-modal','modal-evidence-inspector','modal-photo-lightbox','weather-forecast-modal'].forEach(function(id){
        var m=document.getElementById(id);
        if(m)m.addEventListener('click',function(e){if(e.target===m){closeSubmitModal();closeCapModal(); stopEmergencyAlarm(); close3DTerrainModal(); closeAuthoritySirenModal(); closeEvidenceModal(); closePhotoLightbox(); closeWeatherForecastModal();}});
    });
    // Backdrop close listener
    document.getElementById('weather-forecast-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'weather-forecast-modal') closeWeatherForecastModal();
    });
});

function openWeatherForecastModal() {
    const modal = document.getElementById('weather-forecast-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }
}
window.openWeatherForecastModal = openWeatherForecastModal;

function closeWeatherForecastModal() {
    const modal = document.getElementById('weather-forecast-modal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
}
window.closeWeatherForecastModal = closeWeatherForecastModal;

// =============================================================================
// PAHAD Phase 5: Regional EOC Intelligence Drawer Logic & Guardrails
// =============================================================================

function togglePahadRegionalDrawer() {
    // Guardrail: Never initialize or display in Citizen Mode
    if (typeof currentPortalMode !== 'undefined' && currentPortalMode === 'citizen') {
        console.warn('[PAHAD EOC] Regional Drawer blocked: Authority role required.');
        const dr = document.getElementById('pahad-regional-drawer');
        if (dr) dr.classList.add('hidden');
        return;
    }
    const drawer = document.getElementById('pahad-regional-drawer');
    const chevron = document.getElementById('pahad-drawer-chevron');
    const btn = document.getElementById('btn-pahad-regional-drawer');
    if (!drawer) return;

    const isHidden = drawer.classList.contains('hidden');
    if (isHidden) {
        drawer.classList.remove('hidden');
        if (chevron) chevron.textContent = '▲';
        if (btn) btn.setAttribute('aria-expanded', 'true');
        loadPahadRegionalDrawerData();
    } else {
        drawer.classList.add('hidden');
        if (chevron) chevron.textContent = '▼';
        if (btn) btn.setAttribute('aria-expanded', 'false');
    }
}
window.togglePahadRegionalDrawer = togglePahadRegionalDrawer;

async function loadPahadRegionalDrawerData() {
    // Authority guardrail
    if (typeof currentPortalMode !== 'undefined' && currentPortalMode === 'citizen') return;

    try {
        // 1. Fetch 8-state regional overview
        const ovRes = await fetch('/api/pahad/regional-overview');
        if (ovRes.ok) {
            const ovData = await ovRes.json();
            renderPahadNerGrid(ovData.state_summaries || {});
        }

        // 2. Fetch live priority dispatches
        const prioRes = await fetch('/api/pahad/response-prioritization');
        if (prioRes.ok) {
            const prioData = await prioRes.json();
            renderPahadPrioritizationQueue(prioData.priority_queue || []);
        }
    } catch (err) {
        console.error('[PAHAD EOC] Failed to load regional drawer telemetry:', err);
    }
}
window.loadPahadRegionalDrawerData = loadPahadRegionalDrawerData;

function renderPahadNerGrid(summaries) {
    const grid = document.getElementById('pahad-ner-states-grid');
    if (!grid) return;

    const states = [
        "Sikkim", "Mizoram", "Nagaland", "Arunachal Pradesh",
        "Manipur", "Meghalaya", "Assam", "Tripura"
    ];

    let html = '';
    states.forEach(st => {
        const item = summaries[st] || {
            sector_count: 0,
            highest_cri: 0.0,
            risk_tier: 'WATCH_YELLOW',
            assigned_rescue_force: 'NDRF'
        };

        let badgeBg = 'bg-yellow-950/80 text-yellow-400 border-yellow-800';
        if (item.risk_tier === 'CRITICAL_RED') {
            badgeBg = 'bg-red-950/80 text-red-300 border-red-800';
        } else if (item.risk_tier === 'HIGH_ORANGE') {
            badgeBg = 'bg-amber-950/80 text-amber-300 border-amber-800';
        }

        html += `
            <div class="p-2.5 bg-slate-900/90 border border-slate-800 rounded flex flex-col justify-between text-left transition-all hover:border-slate-700">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="font-bold text-slate-200 text-xs truncate" title="${st}">${st}</span>
                    <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded border ${badgeBg}">${item.sector_count} Sectors</span>
                </div>
                <div class="mt-1">
                    <div class="text-[10px] text-slate-400">Max CRI</div>
                    <div class="text-sm font-bold font-mono text-slate-100">${(item.highest_cri || 0).toFixed(1)}</div>
                </div>
                <div class="mt-1.5 pt-1.5 border-t border-slate-800/80 text-[10px] text-slate-400 truncate" title="${item.assigned_rescue_force}">
                    ${(item.assigned_rescue_force || 'NDRF').split('/')[0]}
                </div>
            </div>
        `;
    });
    grid.innerHTML = html;
}

function renderPahadPrioritizationQueue(queue) {
    const tbody = document.getElementById('pahad-prioritization-tbody');
    if (!tbody) return;

    if (!queue || queue.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" class="py-4 text-center text-slate-500 font-sans">No active sectors require priority staging.</td></tr>';
        return;
    }

    let rows = '';
    queue.slice(0, 10).forEach(item => {
        let advColor = 'text-yellow-400 bg-yellow-950/60 border-yellow-800';
        if (item.urgency_level === 'CRITICAL') {
            advColor = 'text-red-300 bg-red-950/80 border-red-800';
        } else if (item.urgency_level === 'HIGH') {
            advColor = 'text-amber-300 bg-amber-950/80 border-amber-800';
        }

        rows += `
            <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="py-2 px-3 font-bold text-amber-400">#${item.priority_rank}</td>
                <td class="py-2 px-3 font-medium text-slate-200">${item.name || item.sector_id}</td>
                <td class="py-2 px-3 text-slate-400">${item.state}</td>
                <td class="py-2 px-3 text-[11px] text-slate-400 font-sans">${(item.road_criticality || '').replace(/_/g, ' ')}</td>
                <td class="py-2 px-3 text-right text-slate-200">${(item.population_at_risk || 0).toLocaleString()}</td>
                <td class="py-2 px-3 text-right font-bold ${(item.cri_score || 0) >= 80 ? 'text-red-400' : 'text-amber-400'}">${(item.cri_score || 0).toFixed(1)}</td>
                <td class="py-2 px-3 text-right font-bold text-emerald-400">${(item.priority_score || 0).toLocaleString()}</td>
                <td class="py-2 px-3 text-slate-300 text-[11px] font-sans">${item.assigned_rescue_force || 'NDRF'}</td>
                <td class="py-2 px-3">
                    <span class="inline-block px-2 py-0.5 rounded border text-[10px] font-bold ${advColor}">
                        ${(item.evacuation_advisory || '').replace(/_/g, ' ')}
                    </span>
                </td>
            </tr>
        `;
    });
    tbody.innerHTML = rows;
}

async function simulatePahadInSarCreep() {
    // Authority guardrail
    if (typeof currentPortalMode !== 'undefined' && currentPortalMode === 'citizen') return;

    const panel = document.getElementById('pahad-insar-diagnostic-panel');
    const btn = document.getElementById('btn-simulate-insar');
    if (!panel) return;

    panel.classList.remove('hidden');
    if (btn) btn.innerHTML = '<span>Simulating NISAR...</span>';

    try {
        const payload = {
            sector_id: "SK-NH10-KM48",
            displacement_series_mm: [0.0, 3.2, 8.8, 21.5, 46.0],
            days_intervals: [0.0, 12.0, 24.0, 36.0, 48.0],
            coherence: 0.68
        };

        const res = await fetch('/api/pahad/insar-deformation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            const result = await res.json();
            const d = result.data || {};
            const velEl = document.getElementById('pahad-insar-velocity');
            const accEl = document.getElementById('pahad-insar-accel');
            const invEl = document.getElementById('pahad-insar-inv-v');
            const cohEl = document.getElementById('pahad-insar-coherence');
            const badgeEl = document.getElementById('pahad-insar-badge');

            if (velEl) velEl.textContent = `${d.velocity_mm_year} mm/yr`;
            if (accEl) accEl.textContent = `${d.acceleration_mm_day2} mm/day²`;
            if (invEl) invEl.textContent = `${d.inverse_velocity} day/mm`;
            if (cohEl) cohEl.textContent = `${d.coherence} (${d.reliability})`;
            if (badgeEl) badgeEl.textContent = d.creep_status;
        }
    } catch (e) {
        console.error('[PAHAD EOC] InSAR simulation failed:', e);
    } finally {
        if (btn) btn.innerHTML = '<span>Simulate InSAR Tertiary Creep</span>';
    }
}
window.simulatePahadInSarCreep = simulatePahadInSarCreep;

// =============================================================================
// PAHAD PHASE 7: CITIZEN ADVISORY BYPASS & SHELTER CALCULATOR
// =============================================================================

var citizenBypassLayerGroup = null;
var gsiInSarLayerGroup = null;
var gsiInSarActive = false;

// Pre-defined corridor fallback waypoints for precise polyline mapping
const PAHAD_CORRIDOR_WAYPOINTS = {
    'BYP-SK-01': [[26.885, 88.475], [26.892, 88.705], [26.965, 88.702], [27.085, 88.662], [27.125, 88.582], [27.175, 88.528], [27.234, 88.498], [27.330, 88.610]],
    'BYP-SK-02': [[26.885, 88.475], [26.980, 88.430], [26.995, 88.370], [27.012, 88.262], [27.060, 88.470], [27.175, 88.528], [27.330, 88.610]],
    'BYP-SK-03': [[27.060, 88.430], [27.040, 88.400], [27.012, 88.262], [27.175, 88.528]],
    'BYP-NSH-01': [[27.382, 88.583], [27.502, 88.528], [27.540, 88.580], [27.600, 88.640]],
    'BYP-NL-01': [[25.900, 93.730], [25.820, 93.900], [25.750, 93.850], [25.670, 94.100]],
    'BYP-NL-02': [[25.750, 93.850], [25.700, 94.020], [25.670, 94.100]],
    'BYP-ML-01': [[25.578, 91.892], [25.320, 92.350], [25.100, 92.360], [25.040, 92.380]],
    'BYP-MZ-01': [[24.825, 92.795], [24.510, 92.760], [24.220, 92.680], [23.742, 92.708], [23.730, 92.710]],
    'BYP-AR-01': [[26.820, 92.830], [27.010, 92.650], [27.260, 92.420], [27.586, 91.865]],
    'BYP-MN-01': [[24.800, 93.120], [24.815, 93.632], [24.810, 93.930]]
};

const PAHAD_CORRIDOR_ANCHORS = {
    'SK-NH10': { lat: 27.17, lon: 88.50 },
    'SK-NSH': { lat: 27.50, lon: 88.53 },
    'NL-NH29': { lat: 25.67, lon: 94.10 },
    'ML-NH06': { lat: 25.10, lon: 92.36 },
    'MZ-NH06': { lat: 23.74, lon: 92.71 },
    'AR-NH13': { lat: 27.26, lon: 92.42 },
    'MN-NH37': { lat: 24.81, lon: 93.63 }
};

function onCitizenWeightPresetChange(val) {
    var input = document.getElementById('citizen-vehicle-weight-input');
    if (!input) return;
    if (val !== 'custom') {
        input.value = parseFloat(val).toFixed(1);
    }
}
window.onCitizenWeightPresetChange = onCitizenWeightPresetChange;

async function calculateCitizenBypassAndShelters() {
    var corridorSelect = document.getElementById('citizen-corridor-select');
    var weightInput = document.getElementById('citizen-vehicle-weight-input');
    var resultsBox = document.getElementById('citizen-bypass-results-box');
    var recBanner = document.getElementById('citizen-bypass-recommendation-banner');
    var routesList = document.getElementById('citizen-bypass-routes-list');
    var sheltersList = document.getElementById('citizen-shelters-list');
    var badge = document.getElementById('citizen-bypass-count-badge');
    var btn = document.getElementById('btn-citizen-calc-bypass');

    if (!corridorSelect || !weightInput) return;
    var corridorId = corridorSelect.value;
    var weight = parseFloat(weightInput.value) || 32.0;

    if (btn) btn.innerHTML = '<i class="ph-bold ph-spinner animate-spin"></i><span>Calculating Corridor Clearance...</span>';

    try {
        // 1. Post to bypass router
        var bypassRes = await fetch('/api/pahad/routing/calculate-bypass', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                corridor_id: corridorId,
                vehicle_weight_tons: weight
            })
        });
        var bypassData = await bypassRes.json();

        // 2. Query nearest shelters
        var anchor = PAHAD_CORRIDOR_ANCHORS[corridorId] || { lat: 27.17, lon: 88.50 };
        var shelterRes = await fetch('/api/pahad/shelters?lat=' + anchor.lat + '&lon=' + anchor.lon + '&limit=3');
        var shelterData = await shelterRes.json();

        if (resultsBox) resultsBox.classList.remove('hidden');

        // Render Recommendation Banner
        if (recBanner) {
            var hasEligible = (bypassData.eligible_routes && bypassData.eligible_routes.length > 0);
            recBanner.className = 'rounded-lg p-3 mb-4 text-xs font-medium border flex items-start gap-2.5 ' + 
                (hasEligible ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200' : 'bg-red-50 dark:bg-red-950/40 border-red-300 dark:border-red-800 text-red-900 dark:text-red-200');
            recBanner.className = 'border border-slate-300 bg-white p-3 mb-4 text-xs font-medium flex items-start gap-2.5 rounded-none ' + (hasEligible ? 'border-l-4 border-l-emerald-600 text-slate-800' : 'border-l-4 border-l-red-600 text-slate-800');
            recBanner.innerHTML = '<span>' + (hasEligible ? '<strong class="text-emerald-700 font-mono">[PERMITTED]</strong>' : '<strong class="text-red-700 font-mono">[RESTRICTED]</strong>') + '</span><div><strong>Logistics Advisory:</strong> ' + (bypassData.recommendation || 'Evaluation complete.') + '</div>';
        }

        if (badge) {
            badge.textContent = (bypassData.eligible_count || 0) + ' Eligible / ' + (bypassData.total_bypass_options || 0) + ' Evaluated';
        }

        // Render Routes
        if (routesList) {
            var html = '';
            var eligible = bypassData.eligible_routes || [];
            var ineligible = bypassData.ineligible_routes || [];

            eligible.forEach(function(r) {
                html += `
                <div class="p-3.5 rounded-lg border-2 border-emerald-500 bg-emerald-50/40 dark:bg-emerald-950/20 shadow-sm transition hover:shadow">
                    <div class="flex flex-wrap items-center justify-between gap-1 mb-1.5">
                        <div class="flex items-center gap-2">
                            <i class="ph-bold ph-path text-sm text-[#002147]"></i>
                            <span class="font-black text-sm text-[#0B2545] dark:text-emerald-300">${r.name}</span>
                        </div>
                        <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white shadow-sm">
                            ELIGIBLE (${r.max_gvw_tons}T MAX GVW)
                        </span>
                    </div>
                    <div class="text-xs text-slate-700 dark:text-slate-300 mb-2">
                        <strong>Alignment:</strong> ${r.via}
                    </div>
                    <div class="grid grid-cols-3 gap-2 text-center text-xs py-1.5 px-2 rounded bg-white/70 dark:bg-slate-900/60 border border-emerald-200 dark:border-emerald-800/60 mb-2">
                        <div><div class="font-black text-[#0B2545] dark:text-slate-100">+${r.delay_minutes}m</div><div class="text-[10px] text-slate-500">Delay</div></div>
                        <div><div class="font-black text-[#0B2545] dark:text-slate-100">${r.distance_km} km</div><div class="text-[10px] text-slate-500">Distance</div></div>
                        <div><div class="font-black text-emerald-700 dark:text-emerald-400">${r.clearance_status || 'OPEN'}</div><div class="text-[10px] text-slate-500">Status</div></div>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                        <span>Cleared GVW Margin: <strong>+${r.margin_tons || 0}T</strong></span>
                        <button onclick="highlightBypassRouteOnMap('${r.route_id}')" class="px-2.5 py-1 rounded bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-[10px] transition">
                            Show On Map ↗
                        </button>
                    </div>
                </div>`;
            });

            ineligible.forEach(function(r) {
                html += `
                <div class="p-3.5 rounded-lg border border-red-300 dark:border-red-900/60 bg-red-50/30 dark:bg-red-950/10 opacity-80">
                    <div class="flex flex-wrap items-center justify-between gap-1 mb-1.5">
                        <div class="flex items-center gap-2">
                            <i class="ph-bold ph-warning text-sm text-red-600"></i>
                            <span class="font-bold text-sm text-slate-700 dark:text-slate-300 line-through">${r.name}</span>
                        </div>
                        <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-red-700 text-white">
                            REJECTED: OVERWEIGHT
                        </span>
                    </div>
                    <div class="text-xs text-slate-600 dark:text-slate-400 mb-1.5">
                        <strong>Alignment:</strong> ${r.via}
                    </div>
                    <div class="p-2 rounded bg-red-100/60 dark:bg-red-950/40 text-red-700 dark:text-red-300 text-xs font-medium border border-red-200 dark:border-red-800/40">
                        <span class="text-red-600 font-bold font-mono">[REJECTED]</span> <strong>Rejection Reason:</strong> ${r.rejection_reason || ('Vehicle weight ' + weight + 'T exceeds route limit ' + r.max_gvw_tons + 'T')}
                    </div>
                </div>`;
            });

            routesList.innerHTML = html;
        }

        // Render Shelters
        if (sheltersList) {
            var shtml = '';
            var shelters = shelterData.shelters || [];
            shelters.forEach(function(s, idx) {
                var medClass = 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 border-blue-300';
                if (s.medical_readiness && s.medical_readiness.includes('TRAUMA')) {
                    medClass = 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 border-purple-300';
                }
                shtml += `
                <div class="p-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50 shadow-sm">
                    <div class="flex items-start justify-between gap-2 mb-1">
                        <div>
                            <span class="text-xs font-black text-[#0B2545] dark:text-slate-100">#${idx + 1} ${s.name}</span>
                            <span class="block text-[10px] text-slate-500">${s.district}, ${s.state}</span>
                        </div>
                        <span class="text-xs font-black text-emerald-700 dark:text-emerald-400">${s.distance_km || 0} km</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5 my-2">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold border ${medClass}">
                            READINESS: ${(s.medical_readiness || 'FIRST_AID').replace(/_/g, ' ')}
                        </span>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                            CAPACITY: ${(s.capacity_people || 0).toLocaleString()}
                        </span>
                        ${s.has_helipad ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">HELIPAD: ACTIVE</span>' : ''}
                    </div>
                    <div class="text-[11px] text-slate-600 dark:text-slate-400 flex items-center justify-between mt-2 pt-1.5 border-t border-slate-200 dark:border-slate-800">
                        <span>HOTLINE: ${s.satellite_phone || '+91-112'}</span>
                        <button onclick="centerMapOnCoords(${s.lat}, ${s.lon}, '${s.name.replace(/'/g, "\\'")}')" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline text-[10px]">
                            Locate on Map ↗
                        </button>
                    </div>
                </div>`;
            });
            sheltersList.innerHTML = shtml;
        }

        // Draw Detour Polyline & Shelters on Leaflet Map
        drawCitizenBypassOnMap(bypassData.eligible_routes, shelterData.shelters);

    } catch (e) {
        console.error('[CITIZEN BYPASS] Calculation error:', e);
        if (recBanner) {
            recBanner.className = 'rounded-lg p-3 mb-4 text-xs font-medium border bg-red-50 text-red-900 border-red-300';
            recBanner.innerHTML = '<div>Failed to evaluate bypass routing. Please ensure local server connectivity.</div>';
        }
    } finally {
        if (btn) btn.innerHTML = '<i class="ph-bold ph-calculator"></i><span>CALCULATE CORRIDOR CLEARANCE &amp; REFUGE</span>';
    }
}
window.calculateCitizenBypassAndShelters = calculateCitizenBypassAndShelters;

function drawCitizenBypassOnMap(eligibleRoutes, shelters) {
    if (!window.map) return;
    if (!citizenBypassLayerGroup) {
        citizenBypassLayerGroup = L.layerGroup().addTo(window.map);
    } else {
        citizenBypassLayerGroup.clearLayers();
    }

    var bounds = [];

    // Draw eligible route polylines
    if (eligibleRoutes && eligibleRoutes.length > 0) {
        eligibleRoutes.forEach(function(r) {
            var coords = PAHAD_CORRIDOR_WAYPOINTS[r.route_id];
            if (coords && coords.length > 0) {
                var poly = L.polyline(coords, {
                    color: '#059669',
                    weight: 5,
                    dashArray: '8,6',
                    opacity: 0.95
                });
                var popupHtml = '<div style="font-size:12px;font-family:system-ui;min-width:220px;">' +
                    '<div style="font-weight:bold;color:#14532D;margin-bottom:4px;font-size:13px;">[PERMITTED] ' + r.name + '</div>' +
                    '<div><strong>Alignment:</strong> ' + r.via + '</div>' +
                    '<div><strong>Max GVW:</strong> ' + r.max_gvw_tons + 'T</div>' +
                    '<div><strong>Delay:</strong> +' + r.delay_minutes + ' mins (' + r.distance_km + ' km)</div>' +
                    '</div>';
                poly.bindPopup(popupHtml);
                citizenBypassLayerGroup.addLayer(poly);
                coords.forEach(function(c) { bounds.push(c); });
            }
        });
    }

    // Add shelter markers
    if (shelters && shelters.length > 0) {
        shelters.forEach(function(s) {
            var marker = L.circleMarker([s.lat, s.lon], {
                radius: 8,
                fillColor: '#2563eb',
                color: '#ffffff',
                weight: 2,
                opacity: 1,
                fillOpacity: 0.9
            });
            var spopup = '<div style="font-size:12px;font-family:system-ui;min-width:220px;">' +
                '<div style="font-weight:bold;color:#002147;margin-bottom:4px;">[SHELTER] ' + s.name + '</div>' +
                '<div><strong>Distance:</strong> ' + (s.distance_km || 0) + ' km</div>' +
                '<div><strong>Readiness:</strong> ' + (s.medical_readiness || 'FIRST_AID').replace(/_/g, ' ') + '</div>' +
                '<div><strong>Capacity:</strong> ' + (s.capacity_people || 0) + ' civilians</div>' +
                '<div><strong>Hotline:</strong> ' + (s.satellite_phone || '112') + '</div>' +
                '</div>';
            marker.bindPopup(spopup);
            citizenBypassLayerGroup.addLayer(marker);
            bounds.push([s.lat, s.lon]);
        });
    }

    if (bounds.length > 0) {
        window.map.fitBounds(L.latLngBounds(bounds).pad(0.1));
    }
}
window.drawCitizenBypassOnMap = drawCitizenBypassOnMap;

function highlightBypassRouteOnMap(routeId) {
    if (!window.map) return;
    var coords = PAHAD_CORRIDOR_WAYPOINTS[routeId];
    if (coords && coords.length > 0) {
        window.map.fitBounds(L.latLngBounds(coords).pad(0.15));
    }
}
window.highlightBypassRouteOnMap = highlightBypassRouteOnMap;

function centerMapOnCoords(lat, lon, label) {
    if (!window.map) return;
    window.map.setView([lat, lon], 13);
    L.popup()
        .setLatLng([lat, lon])
        .setContent('<div style="font-size:12px;font-weight:bold;color:#0f172a;">[SHELTER] ' + label + '</div>')
        .openOn(window.map);
}
window.centerMapOnCoords = centerMapOnCoords;


// =============================================================================
// PAHAD PHASE 7: AUTHORITY GSI CRITICAL SECTOR & INSAR MAP OVERLAYS
// =============================================================================

const PAHAD_REGIONAL_THRESHOLDS = {
    'Sikkim': { threshold: 35.0, current: 38.5, force: 'BRO Project Swastik / NDRF 2nd Bn' },
    'Mizoram': { threshold: 40.0, current: 42.0, force: 'BRO Project Pushpak / SDRF Aizawl' },
    'Nagaland': { threshold: 30.0, current: 32.0, force: 'BRO Project Sewak / SDRF Kohima' },
    'Meghalaya': { threshold: 50.0, current: 54.0, force: 'NHIDCL / Meghalaya SDRF' },
    'Arunachal Pradesh': { threshold: 45.0, current: 47.5, force: 'BRO Project Vartak / NDRF 12th Bn' },
    'Manipur': { threshold: 32.0, current: 34.0, force: 'BRO Project Sewak / 57 Mtn Div' },
    'Assam': { threshold: 28.0, current: 29.5, force: 'SDRF Guwahati / NDRF 1st Bn' },
    'Tripura': { threshold: 25.0, current: 22.0, force: 'TSR / SDRF Agartala' }
};

async function toggleGsiInSarOverlay() {
    var btn = document.getElementById('btn-toggle-gsi-insar');
    var btnLbl = document.getElementById('lbl-toggle-gsi-insar');
    var lcpToggle = document.getElementById('lc-toggle-gsi-insar');

    if (!window.map) return;

    if (!gsiInSarLayerGroup) {
        gsiInSarLayerGroup = L.layerGroup();
    }

    if (gsiInSarActive) {
        // Deactivate overlay
        window.map.removeLayer(gsiInSarLayerGroup);
        gsiInSarActive = false;
        if (btn) {
            btn.className = 'px-2.5 py-1 bg-slate-900 hover:bg-slate-800 text-amber-300 border border-amber-500/40 rounded text-xs font-bold transition flex items-center gap-1 shadow-sm';
            btn.setAttribute('aria-pressed', 'false');
        }
        if (btnLbl) btnLbl.textContent = 'Toggle GSI Critical Sectors & InSAR';
        if (lcpToggle) lcpToggle.classList.remove('on');
        showToast('GSI Critical Sectors & InSAR overlay hidden', 'info');
        return;
    }

    // Activate overlay
    if (btnLbl) btnLbl.textContent = 'Loading GSI Sectors...';

    try {
        var res = await fetch('/api/pahad/critical-sectors');
        var data = await res.json();
        var sectors = data.sectors || [];

        gsiInSarLayerGroup.clearLayers();

        sectors.forEach(function(s) {
            var color = '#16a34a'; // Green stable
            var fos = 1.45;
            var creepStatus = 'Primary Transient Creep (Stable)';
            var hr = (s.hazard_rating || '').toUpperCase();

            if (hr === 'EXTREME' || hr === 'VERY_HIGH') {
                color = '#dc2626'; // Red
                fos = (hr === 'EXTREME') ? 0.745 : 0.985;
                creepStatus = 'Tertiary Creep Acceleration (FoS < 1.0)';
            } else if (hr === 'HIGH') {
                color = '#ea580c'; // Orange
                fos = 1.150;
                creepStatus = 'Secondary Steady Creep (High Risk)';
            }

            var reg = PAHAD_REGIONAL_THRESHOLDS[s.state] || { threshold: 35.0, current: 38.0, force: 'NDRF / Regional BRO' };
            var isExceeded = reg.current >= reg.threshold;
            var pct = Math.round(((reg.current - reg.threshold) / reg.threshold) * 100);
            var rainTelemetry = reg.current + ' mm/h (Threshold: ' + reg.threshold + ' mm/h ' + (isExceeded ? '— EXCEEDED +' + pct + '%' : '— NORMAL') + ')';
            var assignedForce = reg.force;

            var marker = L.circleMarker([s.lat, s.lon], {
                radius: 8,
                fillColor: color,
                color: '#ffffff',
                weight: 2,
                opacity: 1,
                fillOpacity: 0.85
            });

            var popupHtml = `
            <div style="min-width:270px;font-family:system-ui,-apple-system,sans-serif;font-size:12px;color:#0f172a;line-height:1.45;">
                <div style="font-weight:800;font-size:13px;border-bottom:2px solid ${color};padding-bottom:4px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;">
                    <span style="color:#0f172a;">${s.name}</span>
                    <span style="background:${color};color:#ffffff;font-size:10px;padding:2px 6px;border-radius:4px;font-weight:700;">${s.hazard_rating}</span>
                </div>
                <div style="margin-bottom:3px;"><strong>Sector ID:</strong> <span style="font-family:monospace;font-weight:bold;color:#334155;">${s.sector_id}</span></div>
                <div style="margin-bottom:3px;"><strong>State / District:</strong> ${s.state} (${s.district})</div>
                <div style="margin-bottom:3px;"><strong>Corridor:</strong> ${s.corridor}</div>
                <div style="margin-bottom:3px;"><strong>Physical FoS:</strong> <span style="font-weight:800;color:${color};">${fos.toFixed(3)}</span> <span style="font-size:11px;color:#64748b;">(${creepStatus})</span></div>
                <div style="margin-bottom:3px;"><strong>Rainfall Telemetry:</strong> <span style="color:${isExceeded ? '#dc2626' : '#16a34a'};font-weight:600;">${rainTelemetry}</span></div>
                <div style="margin-bottom:3px;"><strong>Assigned Task Force:</strong> <span style="font-weight:700;color:#003366;">${assignedForce}</span></div>
                <div style="margin-bottom:4px;"><strong>Bedrock Geology:</strong> <span style="color:#475569;font-size:11px;">${s.geology}</span></div>
                <div style="margin-top:6px;font-size:10px;color:#64748b;border-top:1px dashed #cbd5e1;padding-top:4px;display:flex;justify-content:space-between;">
                    <span><strong>Tier:</strong> ${s.monitoring_tier}</span>
                    <span><strong>Sensors:</strong> ${(s.instrumentation || []).join(', ')}</span>
                </div>
            </div>`;

            marker.bindPopup(popupHtml, { maxWidth: 320 });
            gsiInSarLayerGroup.addLayer(marker);
        });

        gsiInSarLayerGroup.addTo(window.map);
        gsiInSarActive = true;

        if (btn) {
            btn.className = 'px-2.5 py-1 bg-emerald-800 hover:bg-emerald-700 text-white border border-emerald-500 rounded text-xs font-bold transition flex items-center gap-1 shadow-sm';
            btn.setAttribute('aria-pressed', 'true');
        }
        if (btnLbl) btnLbl.textContent = 'GSI & InSAR Active (' + sectors.length + ' Sectors)';
        if (lcpToggle) lcpToggle.classList.add('on');
        showToast('Loaded ' + sectors.length + ' GSI critical sectors & InSAR radar overlays across 8 NER states', 'success');

    } catch (e) {
        console.error('[GSI OVERLAY] Failed to load critical sectors:', e);
        if (btnLbl) btnLbl.textContent = 'Toggle GSI Critical Sectors & InSAR';
        showToast('Failed to load GSI critical sectors', 'error');
    }
}

// ==============================================================================
// PAHAD: HISTORICAL LANDSLIDE MEDIA & RECURRENCE ENGINE CLIENT SCRIPT
// ==============================================================================
var historicalCatalogCache = null;
var historicalHotspotsCache = null;

function openHistoricalMediaModal() {
    var modal = document.getElementById('modal-historical-media');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.style.display = 'flex';
    switchHistoryTab('media');
    fetchHistoricalData();
}
window.openHistoricalMediaModal = openHistoricalMediaModal;

function closeHistoricalMediaModal() {
    var modal = document.getElementById('modal-historical-media');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.style.display = 'none';
}
window.closeHistoricalMediaModal = closeHistoricalMediaModal;

function switchHistoryTab(tabKey) {
    var tabs = ['media', 'hotspots', 'correlate'];
    tabs.forEach(function(t) {
        var btn = document.getElementById('tab-btn-history-' + t);
        var content = document.getElementById('tab-content-history-' + t);
        if (btn) {
            if (t === tabKey) {
                btn.className = 'px-4 py-2.5 text-xs font-bold border-b-2 border-amber-400 bg-slate-800 text-amber-300 flex items-center gap-1.5 rounded-none uppercase tracking-wider transition';
            } else {
                btn.className = 'px-4 py-2.5 text-xs font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 flex items-center gap-1.5 rounded-none uppercase tracking-wider transition';
            }
        }
        if (content) {
            if (t === tabKey) {
                content.classList.remove('hidden');
            } else {
                content.classList.add('hidden');
            }
        }
    });

    if (tabKey === 'correlate') {
        var resDiv = document.getElementById('history-correlate-result');
        if (resDiv && !resDiv.innerHTML.trim()) {
            runHistoricalNowcastCorrelation();
        }
    }
}
window.switchHistoryTab = switchHistoryTab;

async function fetchHistoricalData() {
    try {
        if (!historicalCatalogCache) {
            var catRes = await fetch('/api/pahad/history/catalog');
            var catData = await catRes.json();
            if (catData && catData.catalog) {
                historicalCatalogCache = catData.catalog;
                renderHistoricalCatalog(catData.catalog);
            }
        } else {
            renderHistoricalCatalog(historicalCatalogCache);
        }

        if (!historicalHotspotsCache) {
            var hotRes = await fetch('/api/pahad/history/hotspots');
            var hotData = await hotRes.json();
            if (hotData && hotData.hotspots) {
                historicalHotspotsCache = hotData.hotspots;
                renderHistoricalHotspots(hotData.hotspots);
            }
        } else {
            renderHistoricalHotspots(historicalHotspotsCache);
        }
    } catch (err) {
        console.error('[PAHAD HISTORY] Failed to fetch historical data:', err);
    }
}
window.fetchHistoricalData = fetchHistoricalData;

function renderHistoricalCatalog(catalog) {
    var grid = document.getElementById('history-catalog-grid');
    if (!grid) return;
    var html = '';

    var keys = Object.keys(catalog);
    keys.forEach(function(key) {
        var item = catalog[key];
        var photosHtml = '';
        if (item.media_assets && item.media_assets.photos) {
            item.media_assets.photos.forEach(function(p) {
                photosHtml += `
                    <div class="rounded-none border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 p-2 text-[11px] text-slate-800 dark:text-slate-300">
                        <div class="h-28 w-full bg-slate-900 rounded-none overflow-hidden mb-1.5 border border-slate-300 dark:border-slate-700 flex items-center justify-center cursor-pointer" onclick="openPhotoLightbox('${p.url}')">
                            <img src="${p.url}" alt="${p.caption.replace(/"/g, '&quot;')}" class="h-full w-full object-cover rounded-none" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'text-slate-400 text-[10px] font-bold p-2 text-center uppercase\'>[FIELD EVIDENCE PHOTO ARCHIVED]</div>';" />
                        </div>
                        <p class="text-[10px] text-slate-600 dark:text-slate-400 leading-tight font-medium">${p.caption}</p>
                    </div>
                `;
            });
        }

        var videoPlayerHtml = `
            <div class="mt-2.5 rounded-none border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 p-3">
                <div class="flex items-center justify-between text-[11px] font-bold text-slate-800 dark:text-amber-300 mb-2">
                    <span class="flex items-center gap-1.5 uppercase tracking-wider">
                        <span class="w-2 h-2 bg-red-600 rounded-none inline-block"></span>
                        <span>AERIAL DRONE BRIEFING &amp; RUNOUT SURVEY</span>
                    </span>
                    <span class="text-[9px] px-1.5 py-0.5 bg-[#002147] text-white rounded-none border border-slate-500 font-bold uppercase">1080P TACTICAL STREAM</span>
                </div>
                <div class="relative w-full aspect-video bg-black rounded-none overflow-hidden flex flex-col items-center justify-center border border-slate-400 dark:border-slate-800">
                    <iframe src="${item.media_assets ? item.media_assets.video_url : 'https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ'}" title="Disaster Briefing" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                </div>
                <div class="text-[10px] text-slate-600 dark:text-slate-400 mt-1.5 flex items-center justify-between">
                    <span>${item.media_assets ? item.media_assets.aerial_briefing_summary : 'Aerial surveillance video'}</span>
                    <span class="font-bold text-slate-700 dark:text-slate-300 uppercase">[GSI &bull; NDRF AERIAL RECON]</span>
                </div>
            </div>
        `;

        html += `
            <div class="rounded-none border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-4 space-y-3 shadow-none">
                <div class="flex items-start justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-2.5">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-black text-red-700 dark:text-red-400 uppercase tracking-wider">${item.disaster_id}</span>
                            <span class="text-[10px] px-2 py-0.5 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-300 rounded-none font-bold">${item.date}</span>
                        </div>
                        <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-1">${item.name}</h4>
                        <div class="text-[11px] text-slate-600 dark:text-slate-400">${item.location_name} &bull; Coordinates: [${item.coordinates.join(', ')}]</div>
                    </div>
                    <div class="text-right flex-shrink-0">
                        <span class="text-[11px] font-bold px-2 py-1 bg-red-100 dark:bg-red-950 text-red-800 dark:text-red-300 border border-red-300 dark:border-red-800 rounded-none uppercase">
                            ${item.fatalities_description || item.fatalities + ' Fatalities'}
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="p-2.5 bg-slate-100 dark:bg-slate-900 rounded-none border border-slate-300 dark:border-slate-800">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 uppercase font-bold block">Triggering Precipitation</span>
                        <span class="font-bold text-amber-700 dark:text-amber-400 font-mono text-sm">${item.trigger_rainfall_mm} mm</span>
                        <p class="text-[10px] text-slate-600 dark:text-slate-400 mt-0.5">${item.trigger}</p>
                    </div>
                    <div class="p-2.5 bg-slate-100 dark:bg-slate-900 rounded-none border border-slate-300 dark:border-slate-800">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 uppercase font-bold block">Failure Mechanism</span>
                        <span class="font-bold text-blue-800 dark:text-blue-400 text-xs">${item.geological_failure}</span>
                        <p class="text-[10px] text-slate-600 dark:text-slate-400 mt-0.5 font-mono">${item.gsi_record_ref}</p>
                    </div>
                </div>

                <p class="text-xs text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-none border border-slate-300 dark:border-slate-800 leading-relaxed">
                    <strong class="text-slate-900 dark:text-slate-200">GSI Field Notes:</strong> ${item.gsi_geological_notes}
                </p>

                <div class="grid grid-cols-2 gap-2">
                    ${photosHtml}
                </div>

                ${videoPlayerHtml}

                <div class="text-[10px] text-slate-600 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800 pt-2 flex items-center justify-between">
                    <span><strong>Lifeline Impact:</strong> ${item.critical_infrastructure_impact}</span>
                </div>
            </div>
        `;
    });

    grid.innerHTML = html;
}
window.renderHistoricalCatalog = renderHistoricalCatalog;

function renderHistoricalHotspots(hotspots) {
    var tbody = document.getElementById('history-hotspots-body');
    if (!tbody) return;
    var html = '';

    hotspots.forEach(function(h) {
        var isChronic = h.return_period_years <= 2.0;
        var threatBg = isChronic ? 'bg-red-800 text-white border-red-700' : 'bg-amber-800 text-white border-amber-600';
        var docFailures = (h.recorded_events_count !== undefined ? h.recorded_events_count : h.historical_events_count) || 0;
        var threatClass = h.threat_classification || h.repeat_threat_class || 'CHRONIC_RECURRENT_SLUMP';

        html += `
            <tr class="hover:bg-slate-100 dark:hover:bg-slate-800/80 transition">
                <td class="p-2.5 font-mono text-[11px] font-bold text-slate-900 dark:text-slate-100">
                    <div>${h.sector_id}</div>
                    <div class="text-[10px] text-slate-500 font-sans">${h.gsi_database_ref || 'GSI-NLFC'}</div>
                </td>
                <td class="p-2.5 font-bold text-slate-900 dark:text-slate-100">
                    ${h.corridor_name}
                </td>
                <td class="p-2.5 font-semibold text-slate-700 dark:text-slate-300">
                    ${h.state}
                </td>
                <td class="p-2.5 text-slate-800 dark:text-slate-200 font-bold">
                    <span>${docFailures} catalogued</span>
                    <span class="text-[10px] text-slate-500 block font-normal">(${h.events_per_decade} / decade)</span>
                </td>
                <td class="p-2.5">
                    <span class="font-bold ${isChronic ? 'text-red-700 dark:text-red-400' : 'text-amber-700 dark:text-amber-400'}">
                        ${h.return_period_years} yrs
                    </span>
                    ${isChronic ? '<span class="ml-1 text-[9px] px-1 py-0.2 bg-red-800 text-white rounded-none font-black uppercase">CHRONIC</span>' : ''}
                </td>
                <td class="p-2.5">
                    <span class="text-[10px] px-2 py-0.5 rounded-none font-bold border ${threatBg} uppercase">
                        ${threatClass}
                    </span>
                </td>
                <td class="p-2.5 text-right">
                    <button onclick="plotHotspotOnMap(${h.lat}, ${h.lng}, '${h.corridor_name.replace(/'/g, "\\'")}', '${threatClass}')"
                            class="px-2.5 py-1 bg-[#002147] hover:bg-[#001733] text-white text-[10px] font-bold uppercase tracking-wider rounded-none border border-slate-400 transition active:scale-95 ml-auto flex items-center gap-1">
                        <span>PLOT HOTSPOT ON MAP</span>
                    </button>
                </td>
            </tr>
        `;
    });

    tbody.innerHTML = html;
}
window.renderHistoricalHotspots = renderHistoricalHotspots;

function plotHotspotOnMap(lat, lng, label, threatClass) {
    closeHistoricalMediaModal();
    if (window.map) {
        window.map.setView([lat, lng], 15);

        var color = (threatClass.indexOf('CHRONIC') !== -1) ? '#dc2626' : '#f59e0b';
        var pulseMarker = L.circleMarker([lat, lng], {
            radius: 12,
            fillColor: color,
            color: '#ffffff',
            weight: 3,
            fillOpacity: 0.9
        }).addTo(window.map);

        var popupContent = `
            <div style="min-width:250px;font-family:'Noto Sans',system-ui,-apple-system,sans-serif;font-size:12px;color:#0f172a;line-height:1.4;">
                <div style="font-weight:800;font-size:13px;color:${color};border-bottom:2px solid ${color};padding-bottom:4px;margin-bottom:6px;text-transform:uppercase;">
                    [HOTSPOT] HISTORICAL REPEAT HOTSPOT: ${label}
                </div>
                <div style="margin-bottom:3px;"><strong>Repeat Threat Class:</strong> <span style="font-weight:bold;color:${color};">${threatClass}</span></div>
                <div style="margin-bottom:3px;"><strong>Coordinates:</strong> ${lat.toFixed(4)} N, ${lng.toFixed(4)} E</div>
                <div style="margin-top:6px;font-size:11px;color:#334155;background:#f8fafc;border:1px solid #cbd5e1;padding:6px;border-radius:0;">
                    Verified historical failure scar catalogued in Geological Survey of India (GSI) 91,000 pts baseline and ISRO NRSC Landslide Atlas.
                </div>
            </div>
        `;

        pulseMarker.bindPopup(popupContent, { maxWidth: 300 }).openPopup();

        var mapCard = document.getElementById('map') || document.getElementById('gis-map-card');
        if (mapCard) {
            mapCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        showToast('Navigated to historical landslide hotspot: ' + label, 'info');
    }
}
window.plotHotspotOnMap = plotHotspotOnMap;

async function runHistoricalNowcastCorrelation() {
    var sectorSelect = document.getElementById('history-correlate-sector');
    var rainInput = document.getElementById('history-correlate-rainfall');
    var resultBox = document.getElementById('history-correlate-result');
    if (!sectorSelect || !rainInput || !resultBox) return;

    var sectorId = sectorSelect.value;
    var rainfallMm = parseFloat(rainInput.value) || 0.0;

    resultBox.innerHTML = '<div class="text-xs text-slate-400 py-2">Running multi-sensor nowcast delta comparison...</div>';

    try {
        var res = await fetch('/api/pahad/history/correlate-nowcast', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sector_id: sectorId, current_rainfall_mm: rainfallMm })
        });
        var data = await res.json();
        var c = data.correlation;
        if (!c) {
            resultBox.innerHTML = '<div class="text-xs text-red-400">Failed to compute correlation delta.</div>';
            return;
        }

        var badgeColor = 'bg-emerald-800 text-white border-emerald-700';
        var barColor = 'bg-emerald-600';
        if (c.warning_level === 'RED_HIGH_COLLAPSE_RISK') {
            badgeColor = 'bg-red-800 text-white border-red-700';
            barColor = 'bg-red-600';
        } else if (c.warning_level === 'ORANGE_PRE_FAILURE_SATURATION') {
            badgeColor = 'bg-orange-800 text-white border-orange-700';
            barColor = 'bg-orange-500';
        } else if (c.warning_level === 'YELLOW_ELEVATED_WATCH') {
            badgeColor = 'bg-amber-800 text-white border-amber-700';
            barColor = 'bg-amber-500';
        }

        var barWidth = Math.min(100, Math.max(5, c.percentage_of_historical));

        resultBox.innerHTML = `
            <div class="space-y-3">
                <div class="flex items-center justify-between border-b border-slate-300 dark:border-slate-800 pb-2">
                    <div>
                        <div class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase">${c.corridor_name}</div>
                        <div class="text-[10px] text-slate-500 font-mono">${c.sector_id} &bull; ${c.state} &bull; ${c.threat_classification || c.repeat_threat_class}</div>
                    </div>
                    <span class="text-xs font-black px-2.5 py-1 rounded-none border ${badgeColor} uppercase tracking-wider">
                        ${c.warning_level}
                    </span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                    <div class="p-2 bg-slate-100 dark:bg-slate-950 rounded-none border border-slate-300 dark:border-slate-800">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block uppercase font-bold">Current Rainfall</span>
                        <span class="text-base font-bold text-amber-700 dark:text-amber-400 font-mono">${c.current_rainfall_mm.toFixed(1)} mm</span>
                    </div>
                    <div class="p-2 bg-slate-100 dark:bg-slate-950 rounded-none border border-slate-300 dark:border-slate-800">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block uppercase font-bold">Collapse Threshold</span>
                        <span class="text-base font-bold text-red-700 dark:text-red-400 font-mono">${c.historical_collapse_threshold_mm.toFixed(1)} mm</span>
                    </div>
                    <div class="p-2 bg-slate-100 dark:bg-slate-950 rounded-none border border-slate-300 dark:border-slate-800">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block uppercase font-bold">Threshold Ratio</span>
                        <span class="text-base font-bold text-slate-900 dark:text-slate-100 font-mono">${c.exceedance_ratio.toFixed(2)}x</span>
                    </div>
                    <div class="p-2 bg-slate-100 dark:bg-slate-950 rounded-none border border-slate-300 dark:border-slate-800">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block uppercase font-bold">Return Interval</span>
                        <span class="text-base font-bold text-blue-700 dark:text-blue-400 font-mono">${c.return_period_years} yrs</span>
                    </div>
                </div>

                <!-- Progress / Delta Bar -->
                <div>
                    <div class="flex justify-between text-[11px] mb-1 font-semibold">
                        <span class="text-slate-600 dark:text-slate-400">Exceedance Percentage of Historical Collapse Pulse:</span>
                        <span class="font-bold text-slate-900 dark:text-slate-200 font-mono">${c.percentage_of_historical}%</span>
                    </div>
                    <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-none h-2.5 overflow-hidden border border-slate-400 dark:border-slate-700">
                        <div class="${barColor} h-2.5 rounded-none transition-all duration-500" style="width: ${barWidth}%"></div>
                    </div>
                </div>

                <div class="p-2.5 bg-slate-100 dark:bg-slate-950 rounded-none border border-slate-300 dark:border-slate-800 space-y-1 text-xs">
                    <div><strong class="text-slate-900 dark:text-slate-300">Action SOP:</strong> <span class="font-bold text-amber-700 dark:text-amber-300 uppercase">${c.action_guidance}</span></div>
                    <div class="text-[11px] text-slate-600 dark:text-slate-400">${c.historical_recurrence_context}</div>
                </div>
            </div>
        `;
    } catch (err) {
        console.error('[PAHAD NOWCAST CORRELATE] Error:', err);
        resultBox.innerHTML = '<div class="text-xs text-red-400">Failed to correlate nowcast against historical threshold.</div>';
    }
}
window.runHistoricalNowcastCorrelation = runHistoricalNowcastCorrelation;

window.toggleGsiInSarOverlay = toggleGsiInSarOverlay;

</script>


   <!-- Weather Forecast & Radar Modal -->
   <div id="weather-forecast-modal" class="fixed inset-0 z-[99999] hidden items-center justify-center bg-slate-950/75 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="weather-modal-title">
       <div class="relative w-full max-w-2xl rounded-lg border border-slate-700 bg-slate-900 p-6 text-slate-100 shadow-2xl">
           <!-- Header -->
           <div class="flex items-center justify-between border-b border-slate-800 pb-3">
               <div>
                   <h3 id="weather-modal-title" class="text-lg font-bold text-amber-400">IMD Weather Intelligence &amp; Radar Telemetry</h3>
                   <p class="text-xs text-slate-400">Station: IMD AWS #0821 (Mangan District) • Updated 10m ago</p>
               </div>
               <button onclick="closeWeatherForecastModal()" class="rounded-md p-1.5 text-slate-400 hover:bg-slate-800 hover:text-white" aria-label="Close dialog">
                   &times;
               </button>
           </div>

           <!-- Content Grid -->
           <div class="mt-4 space-y-4 text-sm">
               <div class="grid grid-cols-3 gap-3">
                   <div class="rounded-md border border-slate-800 bg-slate-950/60 p-3 text-center">
                       <span class="block text-xs text-slate-400">Current Rate</span>
                       <span class="text-lg font-bold text-amber-400">18.5 mm/hr</span>
                       <span class="block text-[10px] text-amber-500/80">Intense Downpour</span>
                   </div>
                   <div class="rounded-md border border-slate-800 bg-slate-950/60 p-3 text-center">
                       <span class="block text-xs text-slate-400">24h Cumulative</span>
                       <span class="text-lg font-bold text-red-400">142.8 mm</span>
                       <span class="block text-[10px] text-red-500/80">+318% Departure</span>
                   </div>
                   <div class="rounded-md border border-slate-800 bg-slate-950/60 p-3 text-center">
                       <span class="block text-xs text-slate-400">Soil Moisture (VWC)</span>
                       <span class="text-lg font-bold text-orange-400">56.4%</span>
                       <span class="block text-[10px] text-orange-500/80">Near Liquefaction</span>
                   </div>
               </div>

               <!-- Hourly Trend Table -->
               <div>
                   <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-300">6-Hour Precipitation Timeline</h4>
                   <div class="overflow-x-auto rounded border border-slate-800">
                       <table class="w-full text-left text-xs">
                           <thead class="bg-slate-800/60 text-slate-300">
                               <tr>
                                   <th class="p-2">Time</th>
                                   <th class="p-2">Intensity</th>
                                   <th class="p-2">Wind Spd</th>
                                   <th class="p-2">Status</th>
                               </tr>
                           </thead>
                           <tbody class="divide-y divide-slate-800 text-slate-400">
                               <tr><td class="p-2">01:00 - 02:00</td><td class="p-2 text-slate-200">12.0 mm</td><td class="p-2">14 km/h</td><td class="p-2 text-amber-400">Moderate</td></tr>
                               <tr><td class="p-2">02:00 - 03:00</td><td class="p-2 text-slate-200">18.5 mm</td><td class="p-2">22 km/h</td><td class="p-2 text-orange-400">Heavy</td></tr>
                               <tr><td class="p-2">03:00 - 04:00</td><td class="p-2 text-slate-200">24.2 mm</td><td class="p-2">28 km/h</td><td class="p-2 text-red-400">Very Heavy</td></tr>
                               <tr><td class="p-2">04:00 - 05:00</td><td class="p-2 text-slate-200">21.0 mm</td><td class="p-2">19 km/h</td><td class="p-2 text-red-400">Very Heavy</td></tr>
                           </tbody>
                       </table>
                   </div>
               </div>
           </div>

           <!-- Footer -->
           <div class="mt-5 flex justify-end">
               <button onclick="closeWeatherForecastModal()" class="rounded bg-slate-800 px-4 py-1.5 text-xs font-medium text-slate-200 hover:bg-slate-700">
                   Dismiss
               </button>
           </div>
       </div>
    </div>

    <!-- ============================================================================== -->
    <!-- PAHAD: HISTORICAL LANDSLIDE EVIDENCE & RECURRENCE ENGINE MODAL -->
    <!-- ============================================================================== -->
    <div id="modal-historical-media" class="fixed inset-0 z-[99999] hidden items-center justify-center bg-black/75 p-4 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="history-modal-title">
        <div class="relative w-full max-w-5xl max-h-[90vh] flex flex-col rounded-none border border-slate-400 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 shadow-2xl overflow-hidden">
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-slate-400 bg-[#002147] px-6 py-3.5 text-white">
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 bg-amber-400 rounded-none inline-block flex-shrink-0"></span>
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 id="history-modal-title" class="text-sm sm:text-base font-bold text-white tracking-wide uppercase">
                                GEOLOGICAL SURVEY OF INDIA &amp; NRSC &bull; HISTORICAL DISASTER ARCHIVE &amp; RECURRENCE ANALYSIS
                            </h3>
                            <span class="bg-red-700 text-white text-[10px] font-black px-1.5 py-0.5 rounded-none uppercase tracking-wider">
                                GSI 91,000 PTS BASELINE
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-300 mt-0.5">
                            Verified Ground Truth Field Archives, Real Drone Briefings &amp; Decade-Scale Recurrence Analytics
                        </p>
                    </div>
                </div>
                <button onclick="closeHistoricalMediaModal()" class="rounded-none p-1.5 text-slate-300 hover:bg-[#001733] hover:text-white transition text-xl font-bold leading-none border border-slate-400" aria-label="Close dialog">&times;</button>
            </div>

            <!-- Tab Navigation Bar -->
            <div class="flex items-center border-b border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-950 px-6 pt-2 gap-2 overflow-x-auto">
                <button id="tab-btn-history-media" onclick="switchHistoryTab('media')" class="px-4 py-2 text-xs font-bold border-b-2 border-[#002147] text-[#002147] dark:text-amber-300 dark:border-amber-400 flex items-center gap-1.5 rounded-none transition uppercase tracking-wider">
                    <span>[ VERIFIED FIELD EVIDENCE &amp; BRIEFINGS ]</span>
                </button>
                <button id="tab-btn-history-hotspots" onclick="switchHistoryTab('hotspots')" class="px-4 py-2 text-xs font-bold border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 flex items-center gap-1.5 rounded-none transition uppercase tracking-wider">
                    <span>[ SPATIAL RECURRENCE &amp; HOTSPOT PREDICTOR ]</span>
                </button>
                <button id="tab-btn-history-correlate" onclick="switchHistoryTab('correlate')" class="px-4 py-2 text-xs font-bold border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 flex items-center gap-1.5 rounded-none transition uppercase tracking-wider">
                    <span>[ LIVE NOWCAST VS. HISTORICAL FAILURE THRESHOLD ]</span>
                </button>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                <!-- TAB 1: Real Field Evidence & Drone Briefings -->
                <div id="tab-content-history-media" class="space-y-6">
                    <div class="p-3 bg-slate-100 dark:bg-slate-950/60 border border-slate-300 dark:border-slate-700 rounded-none text-xs text-slate-800 dark:text-slate-300 flex items-center justify-between">
                        <span>Documented disaster ground truth from Geological Survey of India (GSI) &amp; District Disaster Management Authorities.</span>
                        <span class="text-emerald-800 dark:text-emerald-400 font-bold uppercase tracking-wider">ARCHIVE COUNT: 6 VERIFIED DISASTERS</span>
                    </div>
                    <!-- Disaster Cards Grid -->
                    <div id="history-catalog-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <!-- Populated by renderHistoricalCatalog -->
                    </div>
                </div>

                <!-- TAB 2: Spatial Recurrence & Repeat Hotspots -->
                <div id="tab-content-history-hotspots" class="hidden space-y-4">
                    <div class="p-3 bg-slate-100 dark:bg-slate-950/60 border border-slate-300 dark:border-slate-700 rounded-none text-xs text-slate-800 dark:text-slate-200 flex items-center justify-between">
                        <span>Derived from <strong>GSI National Inventory (91,000 pts)</strong> and <strong>ISRO NRSC Landslide Atlas (12,385 Mizoram events)</strong></span>
                        <span class="bg-red-800 text-white font-bold px-2 py-0.5 rounded-none text-[11px] uppercase tracking-wider">CHRONIC REPEAT ZONES: RETURN PERIOD &le; 2.0 YEARS</span>
                    </div>
                    <div class="overflow-x-auto border border-slate-300 dark:border-slate-700 rounded-none">
                        <table class="w-full text-left text-xs border-collapse" id="table-history-hotspots">
                            <thead class="bg-[#002147] text-white uppercase text-[11px] tracking-wider">
                                <tr>
                                    <th class="p-2.5 border-b border-slate-400">Corridor ID</th>
                                    <th class="p-2.5 border-b border-slate-400">Sector Name</th>
                                    <th class="p-2.5 border-b border-slate-400">State</th>
                                    <th class="p-2.5 border-b border-slate-400">Documented Failures</th>
                                    <th class="p-2.5 border-b border-slate-400">Mean Return Period</th>
                                    <th class="p-2.5 border-b border-slate-400">Recurrence Category</th>
                                    <th class="p-2.5 border-b border-slate-400 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="history-hotspots-body" class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200">
                                <!-- Populated by renderHistoricalHotspots -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB 3: Live IMD Nowcast vs. Historical Collapse Thresholds -->
                <div id="tab-content-history-correlate" class="hidden space-y-5">
                    <div class="p-4 bg-slate-50 dark:bg-slate-950/70 border border-slate-300 dark:border-slate-800 rounded-none space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-800 dark:text-slate-300 mb-1 uppercase tracking-wider">Target Micro-Corridor:</label>
                                <select id="history-correlate-sector" class="w-full bg-white dark:bg-slate-800 border border-slate-400 dark:border-slate-700 rounded-none px-3 py-2 text-xs text-slate-900 dark:text-white">
                                    <option value="SK-NH10-KM48">NH-10 Km 48 (29th Mile, Singtam-Rangpo, Sikkim)</option>
                                    <option value="ML-SONAPUR-TUNNEL">NH-06 Sonapur Tunnel Portal (Jaintia Hills, Meghalaya)</option>
                                    <option value="MZ-HUNTHAR-VENG">NH-54 / Hunthar Veng Sinking Zone (Aizawl, Mizoram)</option>
                                    <option value="SK-PAGALA-PAHAR">North Sikkim Highway (Pagala Pahar, Sikkim)</option>
                                    <option value="AS-DIMA-HASAO">Jatinga-Lumpur Rail Corridor (Dima Hasao, Assam)</option>
                                    <option value="MN-TUPUL-CORRIDOR">Tupul Station / Ijai Catchment (Manipur)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-800 dark:text-slate-300 mb-1 uppercase tracking-wider">Live IMD Precipitation (mm):</label>
                                <div class="flex items-center gap-2">
                                    <input type="number" id="history-correlate-rainfall" value="125.0" min="0" max="500" step="0.5" class="w-full bg-white dark:bg-slate-800 border border-slate-400 dark:border-slate-700 rounded-none px-3 py-2 text-xs text-slate-900 dark:text-white font-mono">
                                    <span class="text-xs text-slate-600 dark:text-slate-400 font-bold">mm</span>
                                </div>
                            </div>
                            <div class="flex items-end">
                                <button id="btn-run-history-correlate" onclick="runHistoricalNowcastCorrelation()" class="w-full px-4 py-2 bg-[#002147] hover:bg-[#001733] border border-slate-400 text-white font-bold rounded-none text-xs uppercase tracking-wider transition flex items-center justify-center gap-1.5 shadow-none">
                                    <span>RUN IMD DELTA ANALYSIS</span>
                                </button>
                            </div>
                        </div>

                        <!-- Comparator Results Box -->
                        <div id="history-correlate-result" class="p-4 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-none space-y-3">
                            <!-- Populated dynamically by runHistoricalNowcastCorrelation -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-between border-t border-slate-400 bg-[#002147] px-6 py-3 text-xs text-white">
                <span class="text-slate-200">Data Source: GSI NLFC 1:10K Nodal Grid &amp; ISRO NRSC Landslide Atlas of India</span>
                <button onclick="closeHistoricalMediaModal()" class="rounded-none bg-[#001733] px-4 py-1.5 text-xs font-bold text-white hover:bg-slate-800 border border-slate-400 transition uppercase tracking-wider">
                    Close Archive
                </button>
            </div>
        </div>
    </div>
</body>
</html>
