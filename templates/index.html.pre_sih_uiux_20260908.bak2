                    <span class="p-2 rounded-lg bg-[#003366] text-white border border-[#004080] text-lg shadow-sm" aria-hidden="true"><i class="ph-bold ph-mountains"></i></span>
                    <div>
                        <div class="flex items-center gap-2">
