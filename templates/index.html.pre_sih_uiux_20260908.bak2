                <div class="absolute bottom-4 left-4 z-10 p-3.5 rounded-xl bg-slate-900/90 border border-slate-700 text-xs text-slate-300 pointer-events-auto space-y-1 shadow-2xl backdrop-blur-md max-w-xs sm:max-w-sm">
                    <div class="flex items-center justify-between border-b border-slate-700/80 pb-1 mb-1">
