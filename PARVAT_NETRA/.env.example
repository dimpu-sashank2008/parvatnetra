# ==========================================
# PARVAT_NETRA Environment Configuration
# ==========================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------
# GIS Cloud MCP Server
# ------------------------------------------
GIS_CLOUD_API_KEY=your_gis_cloud_api_key_here
GIS_CLOUD_BASE_URL=https://api.giscloud.com/v1
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
DEFAULT_LATITUDE=27.9881
DEFAULT_LONGITUDE=86.9250
DEFAULT_ELEVATION_METERS=5364

# ------------------------------------------
# Weather MCP Server
# ------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL_SECONDS=300

# ------------------------------------------
# Data Analytics MCP Server
# ------------------------------------------
ANALYTICS_DATABASE_URL=postgresql://user:password@localhost:5432/parvat_netra
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default

# ------------------------------------------
# Observability MCP Server
# ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=9090
SENTRY_DSN=

# ------------------------------------------
# Notifications MCP Server
# ------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_EMAIL_RECIPIENTS=alerts@parvatnetra.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------
# Experiential Labs Gateway (gpt-6-astra)
# ------------------------------------------
EXPLABS_API_KEY=your_explabs_api_key_here
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
